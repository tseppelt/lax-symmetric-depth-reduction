import Mathlib.GroupTheory.Perm.ClosureSwap
import Mathlib.GroupTheory.GroupAction.FixingSubgroup
import Lax461425.MatrixSymmetry

/-!
A key group-theoretic fact about the symmetric group, used to show that minimal supports are
well-behaved: if `S, T` are subsets of a finite set `α` whose union is not everything, then the
pointwise stabiliser of `S ∩ T` is generated by the pointwise stabilisers of `S` and of `T`. We
then lift this to `Γ n = Symₙ × Symₙ`.
-/

namespace Lax461425Proofs.PatternsSupportLemma

open Equiv Subgroup MulAction

variable {α : Type*} [Fintype α] [DecidableEq α]

omit [Fintype α] in
/-- Every transposition supported outside `S` fixes `S` pointwise. -/
theorem swap_mem_fixingSubgroup {S : Set α} {a b : α} (ha : a ∉ S) (hb : b ∉ S) :
    swap a b ∈ fixingSubgroup (Perm α) S := by
  intro x
  have hx : (x : α) ∉ ({a, b} : Set α) := by
    rintro (rfl | rfl)
    · exact ha x.2
    · exact hb x.2
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or] at hx
  exact Equiv.swap_apply_of_ne_of_ne hx.1 hx.2

/-- The pointwise stabiliser of `S ∩ T` is generated by the pointwise stabilisers of `S` and of
`T`, provided `S ∪ T ≠ univ`. -/
theorem fixingSubgroup_inter_le {S T : Set α} (h : S ∪ T ≠ Set.univ) :
    fixingSubgroup (Perm α) (S ∩ T) ≤ fixingSubgroup (Perm α) S ⊔ fixingSubgroup (Perm α) T := by
  classical
  -- `d₀` is a point outside both `S` and `T`.
  obtain ⟨d0, hd0⟩ : ∃ x, x ∉ S ∪ T := by
    by_contra hcon
    exact h (Set.eq_univ_of_forall (fun x => by by_contra hx; exact hcon ⟨x, hx⟩))
  simp only [Set.mem_union, not_or] at hd0
  obtain ⟨hd0S, hd0T⟩ := hd0
  -- The generating set: transpositions supported outside `S`, or outside `T`.
  set Gens : Set (Perm α) :=
    {σ | σ.IsSwap ∧ (∀ x ∈ σ.support, x ∉ S)} ∪ {σ | σ.IsSwap ∧ (∀ x ∈ σ.support, x ∉ T)}
    with hGens
  have hGensSwap : ∀ f ∈ Gens, f.IsSwap := by
    rintro f (⟨hf, -⟩ | ⟨hf, -⟩) <;> exact hf
  have hGensSub : Gens ⊆ (fixingSubgroup (Perm α) S : Set (Perm α)) ∪
      (fixingSubgroup (Perm α) T : Set (Perm α)) := by
    rintro f (⟨⟨a, b, hab, rfl⟩, hf⟩ | ⟨⟨a, b, hab, rfl⟩, hf⟩)
    · exact Or.inl (swap_mem_fixingSubgroup (hf a (by simp [hab]))
        (hf b (by simp [hab])))
    · exact Or.inr (swap_mem_fixingSubgroup (hf a (by simp [hab]))
        (hf b (by simp [hab])))
  have hclosure_le : closure Gens ≤ fixingSubgroup (Perm α) S ⊔ fixingSubgroup (Perm α) T := by
    rw [closure_le]
    refine hGensSub.trans ?_
    intro x hx
    rcases hx with hx | hx
    · exact (le_sup_left : fixingSubgroup (Perm α) S ≤ _) hx
    · exact (le_sup_right : fixingSubgroup (Perm α) T ≤ _) hx
  refine le_trans ?_ hclosure_le
  -- It remains to show that `fixingSubgroup (S ∩ T) ≤ closure Gens`.
  intro f hf
  rw [mem_closure_isSwap hGensSwap]
  refine ⟨Set.toFinite _, fun x => ?_⟩
  -- The orbits of `closure Gens` are `{x}` for `x ∈ S ∩ T`, and `Sᶜ ∪ Tᶜ` otherwise.
  by_cases hxC : x ∈ S ∩ T
  · have hfix : f x = x := hf ⟨x, hxC⟩
    rw [hfix]
    exact mem_orbit_self x
  · -- `f` restricts to a bijection of `(S ∩ T)ᶜ`, so `f x ∉ S ∩ T`.
    have hfxC : f x ∉ S ∩ T := by
      intro hmem
      have heq : f (f x) = f x := hf ⟨f x, hmem⟩
      have hfix : f x = x := f.injective heq
      rw [hfix] at hmem
      exact hxC hmem
    -- transitivity of `closure Gens` on `(S ∩ T)ᶜ`
    have htrans : ∀ p q : α, p ∉ S ∩ T → q ∉ S ∩ T → q ∈ orbit (closure Gens) p := by
      have step : ∀ p q : α, p ∉ S → q ∉ S → q ∈ orbit (closure Gens) p := by
        intro p q hp hq
        rcases eq_or_ne p q with rfl | hpq
        · exact mem_orbit_self p
        have hswap : swap p q ∈ closure Gens :=
          subset_closure (Or.inl ⟨⟨p, q, hpq, rfl⟩, fun y hy => by
            have : y = p ∨ y = q := by
              have := Equiv.Perm.support_swap hpq
              rw [this] at hy; simpa using hy
            rcases this with rfl | rfl <;> assumption⟩)
        have : (⟨swap p q, hswap⟩ : closure Gens) • p = q := by
          show swap p q p = q
          exact Equiv.swap_apply_left p q
        exact ⟨⟨swap p q, hswap⟩, this⟩
      have step' : ∀ p q : α, p ∉ T → q ∉ T → q ∈ orbit (closure Gens) p := by
        intro p q hp hq
        rcases eq_or_ne p q with rfl | hpq
        · exact mem_orbit_self p
        have hswap : swap p q ∈ closure Gens :=
          subset_closure (Or.inr ⟨⟨p, q, hpq, rfl⟩, fun y hy => by
            have : y = p ∨ y = q := by
              have := Equiv.Perm.support_swap hpq
              rw [this] at hy; simpa using hy
            rcases this with rfl | rfl <;> assumption⟩)
        have : (⟨swap p q, hswap⟩ : closure Gens) • p = q := by
          show swap p q p = q
          exact Equiv.swap_apply_left p q
        exact ⟨⟨swap p q, hswap⟩, this⟩
      intro p q hp hq
      simp only [Set.mem_inter_iff, not_and_or] at hp hq
      rcases hp with hp | hp
      · rcases hq with hq | hq
        · exact step p q hp hq
        · -- p ∉ S, q ∉ T: route through d0 (d0 ∉ S, d0 ∉ T)
          have h1 : d0 ∈ orbit (closure Gens) p := step p d0 hp hd0S
          have h2 : q ∈ orbit (closure Gens) d0 := step' d0 q hd0T hq
          rwa [orbit_eq_iff.mpr h1] at h2
      · rcases hq with hq | hq
        · have h1 : d0 ∈ orbit (closure Gens) p := step' p d0 hp hd0T
          have h2 : q ∈ orbit (closure Gens) d0 := step d0 q hd0S hq
          rwa [orbit_eq_iff.mpr h1] at h2
        · exact step' p q hp hq
    exact htrans x (f x) hxC hfxC

end Lax461425Proofs.PatternsSupportLemma
